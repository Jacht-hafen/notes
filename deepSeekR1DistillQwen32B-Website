<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kessel - Tea Brewing Timer</title>
    <style>
        :root {
            --primary: #2a190f;
            --secondary: #674535;
            --accent: #ffde4d;
            --light: #ffffff;
            --dark: #2d2826;
            --text: var(--dark);
            --background: var(--light);
            --border: 1px solid var(--secondary);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Helvetica', sans-serif;
            color: var(--text);
            background-color: var(--background);
            line-height: 1.6;
        }

        .hero {
            padding: 2rem;
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            padding: 2rem;
        }

        .feature-card {
            background-color: var(--background);
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .faq {
            padding: 2rem;
            max-width: 800px;
            margin: 0 auto;
        }

        .accordion {
            margin-bottom: 1rem;
        }

        .accordion-header {
            background-color: var(--secondary);
            color: var(--light);
            padding: 1rem;
            border-radius: 4px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .accordion-content {
            display: none;
            padding: 1rem;
        }

        @media (max-width: 700px) {
            .feature-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="hero">
        <h1>Kessel - Perfect Tea Every Time</h1>
        <p>Brew tea with precision and simplicity using our smart timer.</p>
        <button>Get Started</button>
    </div>

    <div class="feature-grid">
        <div class="feature-card">
            <h2>Precise Timing</h2>
            <p>Set exact brewing times for different teas.</p>
        </div>
        <div class="feature-card">
            <h2>Smart Timer</h2>
            <p>Never overbrew again with automatic alerts.</p>
        </div>
        <div class="feature-card">
            <h2>Easy Setup</h2>
            <p>Quick setup and intuitive interface for all users.</p>
        </div>
    </div>

    <div class="faq">
        <h2>Frequently Asked Questions</h2>
        <div class="accordion">
            <div class="accordion-header">How does Kessel work?</div>
            <div class="accordion-content">Kessel uses a precise timer to brew tea perfectly every time.</div>
        </div>
        <div class="accordion">
            <div class="accordion-header">Is it easy to use?</div>
            <div class="accordion-content">Yes, with an intuitive interface designed for all users.</div>
        </div>
        <div class="accordion">
            <div class="accordion-header">What teas can I brew?</div>
            <div class="accordion-content">Any tea! Just set the brewing time according to your preference.</div>
        </div>
        <div class="accordion">
            <div class="accordion-header">Can I customize settings?</div>
            <div class="accordion-content">Absolutely, Kessel allows you to adjust timing and alerts as needed.</div>
        </div>
    </div>

    <script>
        const accordions = document.querySelectorAll('.accordion');
        
        function toggleAccordion(event) {
            event.preventDefault();
            const accordion = event.target.closest('.accordion');
            const content = accordion.querySelector('.accordion-content');
            
            if (content.style.display === 'none' || !content.style.display) {
                content.style.display = 'block';
                event.target.classList.add('active');
            } else {
                content.style.display = 'none';
                event.target.classList.remove('active');
            }
        }

        function init() {
            accordions.forEach(accordion => {
                const header = accordion.querySelector('.accordion-header');
                header.addEventListener('click', toggleAccordion);
                header.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        toggleAccordion(e);
                    }
                });
            });
        }

        init();
    </script>
</body>
</html>
