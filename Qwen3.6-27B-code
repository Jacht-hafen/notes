def parse_csv_line(line: str) -> list[str]:
    fields = []
    current_field = []
    in_quotes = False
    i = 0
    n = len(line)
    while i < n:
        c = line[i]
        if c == '"':
            if in_quotes:
                if i + 1 < n and line[i + 1] == '"':
                    current_field.append('"')
                    i += 2
                    continue
                else:
                    in_quotes = False
            else:
                in_quotes = True
        elif c == ',' and not in_quotes:
            fields.append(''.join(current_field))
            current_field = []
        else:
            current_field.append(c)
        i += 1
    fields.append(''.join(current_field))
    return fields

assert parse_csv_line("a,b,c") == ["a", "b", "c"]
assert parse_csv_line('"hello, world",foo') == ["hello, world", "foo"]
assert parse_csv_line('""test""') == ['"test"']
assert parse_csv_line('"a ""quoted"" field",b') == ['a "quoted" field', 'b']
assert parse_csv_line("x,,y") == ["x", "", "y"]
assert parse_csv_line(" a , b ") == [" a ", " b "]
