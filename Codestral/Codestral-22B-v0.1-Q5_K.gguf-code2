def parse_csv_line(line: str) -> list[str]:
    fields = []
    field = ''
    quote_open = False

    for char in line:
        if char == '"':
            if quote_open and line[i+1] != '"':
                quote_open = False
            else:
                quote_open = True
        elif char == ',' and not quote_open:
            fields.append(field)
            field = ''
        else:
            field += char
    fields.append(field)

    return fields
assert parse_csv_line('a,b,c') == ['a', 'b', 'c']
assert parse_csv_line('"a",b,"c"') == ['a', 'b', 'c']
assert parse_csv_line('"a","b","c"') == ['a', 'b', 'c']
assert parse_csv_line('"a,b","c"') == ['a,b', 'c']
assert parse_csv_line('"a""b",c') == ['ab', 'c']
assert parse_csv_line(',,"",,,""""") == ['', '"', '', '', '"']
