<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kessel — Precision Tea Brewing Timer</title>
<style>
  :root {
    --color-bg: #FAF6F1;
    --color-surface: #FFFFFF;
    --color-text: #2D1810;
    --color-text-muted: #5C4A3A;
    --color-primary: #B8734E;
    --color-primary-hover: #9A5F3F;
    --color-primary-active: #7D4C32;
    --color-border: #DDD2C6;
    --color-accent-bg: #F0E6D9;
    --color-footer-bg: #2D1810;
    --color-footer-text: #FAF6F1;
    --color-focus-ring: #B8734E;

    --font-size-xs: clamp(0.7rem, 1vw + 0.5rem, 0.8rem);
    --font-size-sm: clamp(0.85rem, 1.2vw + 0.5rem, 0.95rem);
    --font-size-base: clamp(0.95rem, 1.5vw + 0.5rem, 1.1rem);
    --font-size-md: clamp(1.1rem, 2vw + 0.5rem, 1.3rem);
    --font-size-lg: clamp(1.4rem, 2.5vw + 0.8rem, 1.8rem);
    --font-size-xl: clamp(1.8rem, 3.5vw + 1rem, 2.8rem);
    --font-size-xxl: clamp(2.2rem, 5vw + 1rem, 4rem);

    --space-xs: clamp(0.4rem, 0.5vw + 0.3rem, 0.6rem);
    --space-sm: clamp(0.6rem, 1vw + 0.4rem, 1rem);
    --space-md: clamp(1rem, 2vw + 0.5rem, 1.5rem);
    --space-lg: clamp(1.5rem, 3vw + 0.8rem, 2.5rem);
    --space-xl: clamp(2rem, 4vw + 1rem, 4rem);
    --space-xxl: clamp(3rem, 6vw + 1.5rem, 6rem);

    --max-width: 80rem;
    --radius-sm: 0.4em;
    --radius-md: 0.8em;
    --radius-lg: 1.2em;
    --nav-height: clamp(3.5rem, 4vw + 1rem, 4.5rem);

    --focus-offset: -0.2em;
    --transition-speed: 0.3s;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: var(--font-size-base);
    line-height: 1.65;
    color: var(--color-text);
    background-color: var(--color-bg);
    -webkit-font-smoothing: antialiased;
  }

  /* Focus styles */
  :focus-visible {
    outline: 0.2em solid var(--color-focus-ring);
    outline-offset: var(--focus-offset);
    border-radius: var(--radius-sm);
  }

  a:focus:not(:focus-visible),
  button:focus:not(:focus-visible) {
    outline: none;
  }

  /* Skip link */
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-sm);
    background: var(--color-primary);
    color: var(--color-footer-text);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    z-index: 100;
    text-decoration: none;
  }

  .skip-link:focus {
    top: var(--space-sm);
  }

  /* Navigation */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-bg);
    border-bottom: 0.1em solid var(--color-border);
    height: var(--nav-height);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    text-decoration: none;
    color: var(--color-text);
    font-size: var(--font-size-md);
    font-weight: 700;
  }

  .nav-logo svg {
    width: auto;
    height: var(--space-lg);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    list-style: none;
  }

  .nav-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: 500;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    transition: color var(--transition-speed), background-color var(--transition-speed);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--color-primary);
    background-color: var(--color-accent-bg);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-xs);
    color: var(--color-text);
  }

  .nav-toggle svg {
    width: auto;
    height: var(--space-md);
  }

  /* Hero */
  .hero {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-xxl) var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .hero-content {
    flex: 1;
    min-width: 0;
  }

  .hero-graphic {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-graphic svg {
    width: clamp(12rem, 25vw, 28rem);
    height: auto;
  }

  .hero-eyebrow {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .hero h1 {
    font-size: var(--font-size-xxl);
    line-height: 1.1;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;
  }

  .hero p {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
    max-width: 38rem;
    margin-bottom: var(--space-lg);
    line-height: 1.55;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    background-color: var(--color-primary);
    color: var(--color-footer-text);
    font-size: var(--font-size-base);
    font-weight: 600;
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-md);
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background-color var(--transition-speed), transform var(--transition-speed);
  }

  .cta-button:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-0.1em);
  }

  .cta-button:active {
    background-color: var(--color-primary-active);
    transform: translateY(0);
  }

  /* Features */
  .features {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-xxl) var(--space-md);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .section-header h2 {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .section-header p {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    max-width: 36rem;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .feature-card {
    background-color: var(--color-surface);
    border: 0.1em solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    transition: box-shadow var(--transition-speed), transform var(--transition-speed);
  }

  .feature-card:hover {
    box-shadow: 0 0.4rem 1.5rem rgba(45, 24, 16, 0.08);
    transform: translateY(-0.2em);
  }

  .feature-icon {
    width: auto;
    height: var(--space-xl);
    margin-bottom: var(--space-md);
    display: block;
  }

  .feature-card h3 {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .feature-card p {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* FAQ */
  .faq {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-xxl) var(--space-md);
    background-color: var(--color-accent-bg);
  }

  .faq-list {
    max-width: 48rem;
    margin: 0 auto;
  }

  .accordion-item {
    border-bottom: 0.1em solid var(--color-border);
  }

  .accordion-button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    background: none;
    border: none;
    padding: var(--space-md) 0;
    cursor: pointer;
    text-align: left;
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    font-family: inherit;
  }

  .accordion-button:hover {
    color: var(--color-primary);
  }

  .accordion-icon {
    flex-shrink: 0;
    width: auto;
    height: var(--space-md);
    transition: transform var(--transition-speed);
  }

  .accordion-button[aria-expanded="true"] .accordion-icon {
    transform: rotate(180deg);
  }

  .accordion-panel {
    overflow: hidden;
    max-height: 0;
    transition: max-height var(--transition-speed) ease, opacity var(--transition-speed) ease;
    opacity: 0;
  }

  .accordion-panel[aria-hidden="false"] {
    max-height: 20rem;
    opacity: 1;
  }

  .accordion-panel p {
    padding-bottom: var(--space-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  /* Footer */
  .footer {
    background-color: var(--color-footer-bg);
    color: var(--color-footer-text);
    padding: var(--space-xl) var(--space-md);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--font-size-md);
    font-weight: 700;
  }

  .footer-brand svg {
    width: auto;
    height: var(--space-md);
  }

  .footer-text {
    font-size: var(--font-size-xs);
    color: rgba(250, 246, 241, 0.7);
  }

  .footer-links {
    display: flex;
    gap: var(--space-md);
    list-style: none;
  }

  .footer-links a {
    color: rgba(250, 246, 241, 0.7);
    text-decoration: none;
    font-size: var(--font-size-xs);
    transition: color var(--transition-speed);
  }

  .footer-links a:hover {
    color: var(--color-footer-text);
  }

  /* Mobile nav overlay */
  .nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(45, 24, 16, 0.5);
    z-index: 49;
  }

  .nav-overlay.active {
    display: block;
  }

  /* Responsive */
  @media (max-width: 700px) {
    .nav-links {
      position: fixed;
      top: var(--nav-height);
      right: 0;
      width: clamp(14rem, 85vw, 20rem);
      height: calc(100vh - var(--nav-height));
      background-color: var(--color-surface);
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-lg) var(--space-md);
      gap: var(--space-xs);
      border-left: 0.1em solid var(--color-border);
      transform: translateX(100%);
      transition: transform var(--transition-speed) ease;
      z-index: 50;
    }

    .nav-links.open {
      transform: translateX(0);
    }

    .nav-links a {
      font-size: var(--font-size-base);
      padding: var(--space-sm) var(--space-md);
    }

    .nav-toggle {
      display: block;
    }

    .hero {
      flex-direction: column-reverse;
      text-align: center;
      padding-top: var(--space-xl);
    }

    .hero p {
      margin-left: auto;
      margin-right: auto;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }

  @media (max-width: 360px) {
    body {
      font-size: var(--font-size-xs);
    }
  }
</style>
</head>
